# Generated from this project's manifest and this machine's hardware: core count,
# memory, and which devices the host actually has. Committing it would carry one
# machine's answers to every other, where a --device against a path that does not
# exist is a hard failure. The extension warns on every open while this is
# missing.
.devcontainer/devcontainer.json
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
