{
  "name": "iron-squid-site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The Iron Squid challenge website.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/catalogue/check.ts && tsx scripts/catalogue/fetch-images.ts && vite build && tsx scripts/emit-pages.ts",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run && bash scripts/check-dns.test.sh && tsx scripts/catalogue/no-game-images.ts",
    "bdd": "bddgen -c e2e/playwright.config.ts && playwright test -c e2e/playwright.config.ts && tsx scripts/check-scenario-count.ts",
    "bdd:manual": "tsx scripts/list-manual-scenarios.ts",
    "bdd:deployed": "bddgen -c e2e/playwright.deployed.config.ts && playwright test -c e2e/playwright.deployed.config.ts && tsx scripts/check-scenario-count.ts --deployed",
    "check-dns": "bash scripts/check-dns.sh",
    "catalogue:generate": "tsx scripts/catalogue/generate.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cucumber/gherkin": "38.0.0",
    "@cucumber/messages": "32.3.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright-bdd": "9.2.1",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": false
  }
}
